# ──────────────────────────────────────────────────────────────
# CivicConnect India — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# ──────────────────────────────────────────────────────────────

# ── App URL ────────────────────────────────────────────────────
APP_URL=http://localhost:3000
FORCE_HTTPS=false

# ── Resend (Email) ─────────────────────────────────────────────
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=CivicConnect India <noreply@yourdomain.com>

# ── Google OAuth ───────────────────────────────────────────────
# Get credentials from https://console.cloud.google.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── Google AdSense (optional) ──────────────────────────────────
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_MID=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_DASHBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_DIRECTORY=
NEXT_PUBLIC_ADSENSE_SLOT_DOWNLOAD=
NEXT_PUBLIC_ADSENSE_SLOT_CONTACT=
NEXT_PUBLIC_ADSENSE_SLOT_COMPLAINT=
NEXT_PUBLIC_ADSENSE_SLOT_LEARN_INDEX=
NEXT_PUBLIC_ADSENSE_SLOT_LEARN_ARTICLE=
