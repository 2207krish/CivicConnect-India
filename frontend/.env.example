# ──────────────────────────────────────────────────────────────
# CivicConnect India — Environment Variables
# Copy this file to .env.local and fill in the values.
# On Railway, set these as environment variables in the dashboard.
# ──────────────────────────────────────────────────────────────

# ── App URL ────────────────────────────────────────────────────
# Set to your public domain (Railway URL or custom domain).
# Used for building verification email links and enforcing HTTPS.
APP_URL=http://localhost:3000
# On Railway / live host:
# APP_URL=https://your-app.up.railway.app
# APP_URL=https://your-domain.in
FORCE_HTTPS=false
# On Railway: FORCE_HTTPS=true

# ── Resend (Email) ─────────────────────────────────────────────
# Sign up at https://resend.com, create an API key, and
# verify your sending domain (or use onboarding@resend.dev for testing).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=CivicConnect India <noreply@yourdomain.in>
# For testing without a verified domain, use:
# RESEND_FROM=CivicConnect India <onboarding@resend.dev>

# ── Google OAuth ───────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create a project → APIs & Services → Credentials
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add Authorized JavaScript origins: https://your-domain.in
# 5. Add Authorized redirect URIs: https://your-domain.in (no callback path needed for GIS)
# NEXT_PUBLIC_ prefix makes this available in the browser bundle
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# Used server-side to verify ID tokens (same value as above, kept server-side for safety)
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google AdSense (optional) ──────────────────────────────────
# Apply only after /learn articles are live on your public HTTPS domain.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_MID=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_DASHBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_DIRECTORY=
NEXT_PUBLIC_ADSENSE_SLOT_DOWNLOAD=
NEXT_PUBLIC_ADSENSE_SLOT_CONTACT=
NEXT_PUBLIC_ADSENSE_SLOT_COMPLAINT=
NEXT_PUBLIC_ADSENSE_SLOT_LEARN_INDEX=
NEXT_PUBLIC_ADSENSE_SLOT_LEARN_ARTICLE=
