# Copy this file to .env.local and fill in your mailbox.
# Gmail: turn on 2-Step Verification, then create an App Password
# at https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=CivicConnect India <your.gmail@gmail.com>
APP_URL=http://localhost:3000
FORCE_HTTPS=false
# On the live host with Let's Encrypt / Vercel SSL:
# APP_URL=https://your-domain.in
# FORCE_HTTPS=true

# Google AdSense (website ads). Apply only after /learn articles are live
# on your public HTTPS domain and show in Google Search (site:your-domain.in).
# Applying against a complaints-only site is likely to be rejected as low-value content.
# After approval, set NEXT_PUBLIC_ADSENSE_CLIENT to your ca-pub- ID.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_MID=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_DASHBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_DIRECTORY=
NEXT_PUBLIC_ADSENSE_SLOT_DOWNLOAD=
NEXT_PUBLIC_ADSENSE_SLOT_CONTACT=
NEXT_PUBLIC_ADSENSE_SLOT_COMPLAINT=
NEXT_PUBLIC_ADSENSE_SLOT_LEARN_INDEX=
NEXT_PUBLIC_ADSENSE_SLOT_LEARN_ARTICLE=
